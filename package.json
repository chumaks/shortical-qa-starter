{
  "name": "shortical-qa-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter QA automation for Shortical: Playwright (web) + WebdriverIO/Appium (Android).",
  "type": "module",
  "scripts": {
    "test:web": "playwright test -c web/playwright.config.ts",
    "test:web:report": "playwright show-report artifacts/web-report",
    "setup:android": "appium driver install uiautomator2",
    "inspect:android": "tsx mobile/scripts/inspect-android.ts",
    "test:android": "wdio run mobile/wdio.android.conf.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "rules": "tsx scripts/check-rules.ts",
    "selftest": "tsx scripts/selftest.ts",
    "list:web": "playwright test -c web/playwright.config.ts --list --reporter=list",
    "check:wdio": "tsx scripts/check-wdio-config.ts",
    "verify": "npm run typecheck && npm run lint && npm run rules && npm run selftest && npm run list:web && npm run check:wdio",
    "earned": "tsx scripts/check-earned.ts",
    "summary": "tsx scripts/report-summary.ts",
    "mutate": "tsx scripts/mutation-check.ts",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.2",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "webdriverio": "^10.1.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "body-parser": "^2.4.0",
    "serialize-javascript": "^7.1.3"
  }
}
